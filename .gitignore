# Saidas geradas pelo clustering (executar src/clustering_comparacao.py)
# Versiona os artefatos prontos consumidos pelo dashboard (app.py).
data/resultados_cluster/*
!data/resultados_cluster/dados_clusterizados.parquet
!data/resultados_cluster/resumo_clusters.csv
!data/resultados_cluster/metricas_k.csv
!data/resultados_cluster/metricas_comparacao.csv
 
# Notas locais (nao versionar)
docs/respostas-feedback-orientador.md
docs/respostas-feedback-orientador.txt

# Artefatos do modelo supervisionado (executar src/train_model.py)
# Ignora as saidas derivadas (tabelas/CSVs/markdown), mas versiona o artefato
# do modelo treinado e suas metricas (consumidos pelo app via src/predictor.py).
data/modelo/*
!data/modelo/dcv_modelo.pkl
!data/modelo/metricas_modelo.json 
